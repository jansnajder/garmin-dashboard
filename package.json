{
  "name": "garmin-dashboard",
  "version": "1.0.0",
  "description": "Personal Garmin health dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -n frontend,electron -c blue,green --kill-others-on-fail \"npm --prefix frontend run dev\" \"npm run start\"",
    "freeze": "cd backend && uv run pyinstaller backend.spec --noconfirm",
    "pack": "npm run freeze && electron-builder --dir",
    "dist": "npm run freeze && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.benderrobotics.garmindashboard",
    "productName": "Garmin Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
